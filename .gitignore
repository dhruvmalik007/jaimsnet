# Secrets & credentials — never commit these
.env
.env.*
*.secret
secrets.yaml
*-secret.yaml
*-secrets.yaml
# Exception: InfisicalSecret CRD manifests in secrets/ are safe to commit
!secrets/gateway-secrets.yaml
!secrets/observability-secrets.yaml
kubeconfig
kubeconfig.*
*.kubeconfig

# Infisical local config
.infisical.json

# Helm chart dependencies & caches
charts/
*.tgz
.helm/

# OpenTofu / Terraform state
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
.tofu/
*.tfplan

# Editor & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# Temporary & build artifacts
tmp/
temp/
*.tmp
*.log
dist/
build/

# Python virtualenvs (scripts)
.venv/
__pycache__/
*.pyc
